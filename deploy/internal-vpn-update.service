[Unit]
Description=Apply current internal VPN membership
After=network-online.target wg-quick@ivpn0.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/internal-vpn/run-host.py --config /etc/internal-vpn/host.json --state /var/lib/internal-vpn
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=internal-vpn
StateDirectoryMode=0700
PrivateTmp=true
CapabilityBoundingSet=CAP_NET_ADMIN
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
