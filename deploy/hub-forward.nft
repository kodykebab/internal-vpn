# Template: set the interface and subnet for the host, and merge into the existing firewall.
table inet internal_vpn {
    chain forward {
        type filter hook forward priority 0; policy accept;
        iifname "ivpn0" oifname "ivpn0" ip saddr 100.100.64.0/24 ip daddr 100.100.64.0/24 accept
        iifname "ivpn0" counter drop
        oifname "ivpn0" counter drop
    }
}
