{
  "doctype": "DocType",
  "name": "VPN Server",
  "module": "Internal VPN",
  "autoname": "hash",
  "engine": "InnoDB",
  "field_order": [
    "label",
    "user",
    "public_key",
    "address",
    "enabled",
    "report_section",
    "reported_revision",
    "apply_success",
    "reported_at",
    "reported_digest"
  ],
  "fields": [
    {
      "fieldname": "label",
      "label": "Name",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "user",
      "label": "Host User",
      "fieldtype": "Link",
      "options": "User",
      "reqd": 1,
      "set_only_once": 1,
      "description": "A dedicated user with the VPN Host role. Its API key authenticates the host agent."
    },
    {
      "fieldname": "public_key",
      "label": "WireGuard Public Key",
      "fieldtype": "Data",
      "reqd": 1,
      "unique": 1
    },
    {
      "fieldname": "address",
      "label": "Address",
      "fieldtype": "Data",
      "read_only": 1,
      "unique": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "enabled",
      "label": "Enabled",
      "fieldtype": "Check",
      "default": "1",
      "in_list_view": 1
    },
    {
      "fieldname": "report_section",
      "label": "Agent Report",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "reported_revision",
      "label": "Reported Revision",
      "fieldtype": "Int",
      "read_only": 1
    },
    {
      "fieldname": "apply_success",
      "label": "Applied",
      "fieldtype": "Check",
      "read_only": 1
    },
    {
      "fieldname": "reported_at",
      "label": "Reported At",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "reported_digest",
      "label": "Reported Digest",
      "fieldtype": "Data",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "VPN Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ],
  "title_field": "label",
  "show_title_field_in_link": 1,
  "search_fields": "label,address,user",
  "track_changes": 1
}
