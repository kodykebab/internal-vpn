{
  "doctype": "DocType",
  "name": "VPN Network",
  "module": "Internal VPN",
  "issingle": 1,
  "engine": "InnoDB",
  "field_order": [
    "subnet",
    "hub",
    "hub_endpoint",
    "revision",
    "hub_digest",
    "hub_alert"
