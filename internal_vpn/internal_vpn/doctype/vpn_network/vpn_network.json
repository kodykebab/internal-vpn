      "read_only": 1
    },
    {
      "fieldname": "hub_digest",
      "label": "Hub Digest",
      "fieldtype": "Data",
      "read_only": 1,
      "hidden": 1
    },
    {
      "fieldname": "hub_alert",
      "label": "Hub Alert",
      "fieldtype": "Data",
      "read_only": 1,
      "hidden": 1
    }
  ],
  "permissions": [
    {
      "role": "VPN Manager",
      "read": 1,
      "write": 1
    }
  ],
  "track_changes": 1
}
